{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.dev/schemas/dev-handoff-v1.json",
  "title": "Dev Kit Handoff V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "change_id", "baseline_ref", "implementation",
    "requirements_coverage", "verification", "review", "business_ambiguity",
    "human_gate", "known_risks", "state"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "$ref": "#/$defs/nonEmpty" },
    "baseline_ref": { "$ref": "#/$defs/baselineRef" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "changed_components"],
      "properties": {
        "commits": { "$ref": "#/$defs/stringList" },
        "changed_components": { "$ref": "#/$defs/stringList" }
      }
    },
    "requirements_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "evidence"],
        "properties": {
          "requirement_id": { "$ref": "#/$defs/nonEmpty" },
          "status": { "enum": ["COVERED", "NOT_COVERED", "DEFERRED"] },
          "evidence": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "tests", "static_checks"],
      "properties": {
        "build": { "type": "array", "items": { "$ref": "#/$defs/namedCheck" } },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/namedCheck" } },
        "static_checks": { "type": "array", "items": { "$ref": "#/$defs/namedCheck" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_reviews", "blocking_fix_waves", "scoped_rereviews", "blocking_findings", "followups"],
      "properties": {
        "full_reviews": { "type": "integer", "minimum": 0, "maximum": 1 },
        "blocking_fix_waves": { "type": "integer", "minimum": 0, "maximum": 1 },
        "scoped_rereviews": { "type": "integer", "minimum": 0, "maximum": 1 },
        "blocking_findings": { "type": "array", "items": { "$ref": "#/$defs/blockingFinding" } },
        "followups": { "type": "array", "items": { "$ref": "#/$defs/followup" } }
      }
    },
    "business_ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": { "enum": ["CLEAR", "NEEDS_BA_CLARIFICATION"] },
        "items": { "$ref": "#/$defs/stringList" }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "resolved"],
      "properties": {
        "required": { "type": "boolean" },
        "resolved": { "type": "boolean" },
        "choice": { "enum": ["approve", "reject", null] },
        "workflow_run_id": { "type": ["string", "null"], "minLength": 1 },
        "workflow_state_path": { "type": ["string", "null"], "minLength": 1 },
        "planning_artifacts_sha256": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["dev-plan.md", "dev-tasks.md"],
          "properties": {
            "dev-plan.md": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "dev-tasks.md": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "known_risks": { "$ref": "#/$defs/stringList" },
    "state": { "enum": ["IN_PROGRESS", "NEEDS_BA_CLARIFICATION", "NEEDS_REPLAN", "HUMAN_TECH_LEAD_REVIEW", "READY_FOR_TEST"] }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
    "baselineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "namedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "command", "exit_code"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "command": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "exit_code": { "type": "integer" }
      }
    },
    "blockingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "description"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "class": { "const": "BLOCKING" }, "description": { "$ref": "#/$defs/nonEmpty" } }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "description"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "class": { "const": "FOLLOW_UP" }, "description": { "$ref": "#/$defs/nonEmpty" } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "READY_FOR_TEST" } } },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "build": { "minItems": 1, "items": { "properties": { "status": { "const": "PASS" }, "exit_code": { "const": 0 } } } },
              "tests": { "minItems": 1, "items": { "properties": { "status": { "const": "PASS" }, "exit_code": { "const": 0 } } } },
              "static_checks": { "items": { "properties": { "status": { "const": "PASS" }, "exit_code": { "const": 0 } } } }
            }
          },
          "implementation": { "properties": { "changed_components": { "minItems": 1 } } },
          "requirements_coverage": { "minItems": 1, "items": { "properties": { "status": { "const": "COVERED" }, "evidence": { "minItems": 1 } } } },
          "business_ambiguity": { "properties": { "status": { "const": "CLEAR" }, "items": { "maxItems": 0 } } },
          "human_gate": { "properties": { "resolved": { "const": true } } },
          "review": { "properties": { "full_reviews": { "const": 1 }, "blocking_findings": { "maxItems": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "human_gate": { "properties": { "required": { "const": true }, "resolved": { "const": true } } } } },
      "then": {
        "properties": {
          "human_gate": {
            "required": ["choice", "workflow_run_id", "workflow_state_path", "planning_artifacts_sha256"],
            "properties": {
              "choice": { "const": "approve" },
              "workflow_run_id": { "type": "string", "minLength": 1 },
              "workflow_state_path": { "type": "string", "minLength": 1 },
              "planning_artifacts_sha256": { "type": "object" }
            }
          }
        }
      }
    }
  ]
}
