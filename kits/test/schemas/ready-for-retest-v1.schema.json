{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ready for Retest Handoff V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_class", "defect_id", "feature_id", "defect_handoff_ref", "finding_ref", "original_execution_manifest_ref", "approved_testware_ref", "testcase_ref", "automation_revision", "previous_application_revisions", "fixed_application_revisions", "dev_fix_handoff_ref", "dev_fix_verification_ref", "environment_ref", "dev_local_references", "verification_owner", "state"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_class": {"const": "HANDOFF_MANIFEST"}, "defect_id": {"type": "string", "minLength": 1}, "feature_id": {"type": "string", "minLength": 1},
    "defect_handoff_ref": {"$ref": "#/$defs/ref"}, "finding_ref": {"$ref": "#/$defs/ref"}, "original_execution_manifest_ref": {"$ref": "#/$defs/ref"},
    "approved_testware_ref": {"$ref": "#/$defs/ref"}, "testcase_ref": {"$ref": "#/$defs/oracle_ref"},
    "automation_revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "previous_application_revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}},
    "fixed_application_revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}},
    "dev_fix_handoff_ref": {"$ref": "#/$defs/ref"}, "dev_fix_verification_ref": {"$ref": "#/$defs/ref"}, "environment_ref": {"$ref": "#/$defs/ref"},
    "dev_local_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["testcase_id", "evidence_refs"], "properties": {"testcase_id": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}}}},
    "verification_owner": {"const": "TESTER"}, "state": {"const": "READY_FOR_RETEST"}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1}}},
    "oracle_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "sha256", "path"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1}}}
  }
}
