{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Observation V1",
  "type": "object", "additionalProperties": false,
  "required": ["observation_id", "execution_id", "testcase_id", "oracle_ref", "oracle_locator", "actual_summary", "evidence_refs", "actor", "outcome", "recorded_at"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1}, "execution_id": {"type": "string", "minLength": 1},
    "testcase_id": {"type": "string", "minLength": 1}, "aut_id": {"type": "string", "minLength": 1},
    "oracle_ref": {"$ref": "#/$defs/oracle_ref"}, "oracle_locator": {"type": "string", "minLength": 1},
    "actual_summary": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["actor_id", "role"], "properties": {"actor_id": {"type": "string", "minLength": 1}, "role": {"const": "TESTER"}}},
    "outcome": {"enum": ["PASS", "FINDING"]}, "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1}}},
    "oracle_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "sha256", "path"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1}}}
  }
}
