{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.invalid/kits/test/automation-suitability-v1.schema.json",
  "title": "Automation Suitability V1",
  "description": "Exact one-row-per-approved-Testcase technical disposition. This artifact is not business authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_class", "feature_id", "revision", "approved_testware_ref", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_class": {"const": "CANONICAL"},
    "feature_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/id"},
    "approved_testware_ref": {"$ref": "#/$defs/artifactRef"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portablePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "sha256", "path"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}, "path": {"$ref": "#/$defs/portablePath"}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "required", "resolution_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["SEMANTIC_ORACLE", "ENVIRONMENT_ACCESS", "TEST_DATA_FIXTURE", "IMPLEMENTATION_LOCATOR", "TOOLING", "OBSERVABILITY"]},
        "status": {"enum": ["OPEN", "RESOLVED", "NOT_REQUIRED"]},
        "required": {"type": "boolean"},
        "resolution_ref": {"type": ["string", "null"]}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["testcase_id", "classification", "owner", "required", "rationale", "dependency_refs"],
      "properties": {
        "testcase_id": {"$ref": "#/$defs/id"},
        "classification": {"enum": ["UNIT", "COMPONENT", "CONTRACT", "DB_RUNTIME", "API", "INTEGRATION", "E2E", "ACCESSIBILITY", "SYSTEM", "MANUAL_ONLY", "BLOCKED"]},
        "owner": {"enum": ["DEV_LOCAL_REFERENCE", "TEST_AUTOMATION", "MANUAL", "BLOCKED"]},
        "required": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1},
        "dependency_refs": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}
      }
    }
  }
}
