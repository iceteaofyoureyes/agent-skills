{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Execution Manifest V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_class", "execution_id", "feature_id", "execution_ready_ref", "environment_ref", "approved_testware_ref", "automation_plan_ref", "application_revisions", "automation_repository", "automation_revision", "automated_items", "manual_testcases", "dev_local_references", "optional_blocked_testcases", "created_at"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_class": {"const": "CANONICAL"},
    "execution_id": {"$ref": "#/$defs/id"}, "feature_id": {"$ref": "#/$defs/id"},
    "execution_ready_ref": {"$ref": "#/$defs/ref"}, "environment_ref": {"$ref": "#/$defs/ref"},
    "approved_testware_ref": {"$ref": "#/$defs/ref"}, "automation_plan_ref": {"$ref": "#/$defs/ref"},
    "application_revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}},
    "automation_repository": {"type": "object", "additionalProperties": false, "required": ["id", "role", "repository", "path"], "properties": {"id": {"$ref": "#/$defs/id"}, "role": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}}},
    "automation_revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "automated_items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["aut_id", "testcase_refs"], "properties": {"aut_id": {"$ref": "#/$defs/id"}, "testcase_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}}, "uniqueItems": true},
    "manual_testcases": {"type": "array", "items": {"$ref": "#/$defs/testcase"}},
    "dev_local_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["testcase_id", "evidence_refs"], "properties": {"testcase_id": {"$ref": "#/$defs/id"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}}}},
    "optional_blocked_testcases": {"type": "array", "items": {"$ref": "#/$defs/testcase"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"$ref": "#/$defs/path"}}},
    "testcase": {"type": "object", "additionalProperties": false, "required": ["testcase_id", "testcase_collection_ref"], "properties": {"testcase_id": {"$ref": "#/$defs/id"}, "testcase_collection_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "sha256", "path"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"$ref": "#/$defs/path"}}}}}
  }
}
