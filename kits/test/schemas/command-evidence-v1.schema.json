{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Automation Command Evidence V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_class", "execution_id", "aut_id", "testcase_refs", "application_revisions", "automation_revision", "environment_ref", "argv", "started_at", "completed_at", "exit_code", "stdout_sha256", "stderr_sha256", "status"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_class": {"const": "EVIDENCE"},
    "execution_id": {"type": "string", "minLength": 1}, "aut_id": {"type": "string", "minLength": 1},
    "testcase_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "application_revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}},
    "automation_revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "environment_ref": {"$ref": "#/$defs/ref"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": "integer"}, "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["COMMAND_PASS", "COMMAND_FAIL"]}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1}}}}
}
