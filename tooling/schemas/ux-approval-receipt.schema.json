{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UX Human Approval Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "source",
    "approver",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identity"
      ],
      "properties": {
        "role": {
          "const": "HUMAN"
        },
        "identity": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "decision": {
      "const": "APPROVE"
    }
  }
}
