{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project execution finding defect retest V1",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "feature_id",
    "testware_ref",
    "dev_handoff_ref",
    "delivery_ref",
    "implementation_commit",
    "dependencies",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "EXECUTION_READINESS",
        "EXECUTION_READY",
        "EXECUTING",
        "PASS",
        "FINDING",
        "FINDING_CLASSIFIED",
        "DEFECT_READY_FOR_DEV",
        "BA_DECISION_REQUIRED",
        "TEST_ENV_CORRECTION",
        "TEST_ISSUE",
        "FIX_IMPLEMENTED",
        "READY_FOR_RETEST",
        "RETESTING",
        "VERIFIED",
        "REOPENED"
      ]
    },
    "feature_id": {
      "type": "string"
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status",
          "required"
        ],
        "properties": {
          "kind": {
            "enum": [
              "SEMANTIC_ORACLE",
              "ENVIRONMENT_ACCESS",
              "TEST_DATA_FIXTURE",
              "IMPLEMENTATION_LOCATOR",
              "TOOLING",
              "OBSERVABILITY"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "NOT_REQUIRED"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "history": {
      "type": "array"
    }
  }
}
