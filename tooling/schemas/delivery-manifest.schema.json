{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Delivery Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature",
    "delivery_revision",
    "ba",
    "ux",
    "targets",
    "open_items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "delivery_revision": {
      "type": "string"
    },
    "ba": {
      "type": "object",
      "required": [
        "handoff"
      ]
    },
    "ux": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "contract": {
          "type": "object"
        },
        "prototype": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "contract"
        ]
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "module",
          "base_revision"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "base_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "open_items": {
      "type": "object",
      "required": [
        "blocking"
      ],
      "properties": {
        "blocking": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
