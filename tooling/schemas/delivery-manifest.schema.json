{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Delivery Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature",
    "delivery_revision",
    "ba",
    "ux",
    "targets",
    "open_items"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "feature": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        }
      },
      "additionalProperties": false
    },
    "delivery_revision": {
      "type": "string"
    },
    "ba": {
      "type": "object",
      "required": [
        "handoff"
      ],
      "additionalProperties": false,
      "properties": {
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "revision",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "ux": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "revision",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "prototype": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "authority"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "authority": {
              "const": "REVIEW_EVIDENCE"
            }
          }
        },
        "approval_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "required"
                ]
              },
              {
                "required": [
                  "contract"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "contract",
              "approval_receipt"
            ]
          }
        },
        {
          "if": {
            "required": [
              "approval_receipt"
            ]
          },
          "then": {
            "required": [
              "contract"
            ]
          }
        }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "module",
          "base_revision"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "module": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "base_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "open_items": {
      "type": "object",
      "required": [
        "blocking"
      ],
      "properties": {
        "blocking": {
          "type": "array",
          "maxItems": 0
        },
        "non_blocking": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  }
}
