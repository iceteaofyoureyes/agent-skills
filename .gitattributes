# Test package authority hashes raw source bytes. Common text extensions below
# span every manifest-selected source tree, so source-set growth keeps LF bytes.
kits/dev/** text eol=lf
dev-kit/** text eol=lf
LICENSE text eol=lf

# Reviewed BA and Test Kit evidence hashes bind exact LF bytes.
kits/ba/examples/CR-001/** text eol=lf
benchmark/test-kit/**/*.md text eol=lf
benchmark/test-kit/**/*.json text eol=lf
benchmark/test-kit/**/*.yml text eol=lf
benchmark/test-kit/**/*.yaml text eol=lf

# Canonical UX receipt fixture hashes bind these exact source bytes.
tooling/tests/fixtures/delivery-ux-canonical/** text eol=lf

# Shared payloads and synthetic exact references are stable across clean checkouts.
shared/** text eol=lf
project-foundation/** text eol=lf
*.zip binary
tooling/tests/fixtures/synthetic-*-foundation/** text eol=lf

